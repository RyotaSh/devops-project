# create .gitignore with (in your editor or:)
@"
# Dependencies
node_modules/

# IDE
.idea/
.vscode/

# Env files
.env
.env.*

# Logs
*.log
"@ | Out-File -Encoding utf8 .gitignore

git status
git add .gitignore package.json app.js
git commit -m "Add minimal API with /health endpoint and .gitignore"
# Terraform
*.tfstate
*.tfstate.*
.terraform/
crash.log
*.tfplan
# tfvars that contain secrets (env tfvars without secrets are committed)
secrets.tfvars
*.secret.tfvars
# local "remote-like" backend folder
infra/shared-state/
infra/preview/state/
